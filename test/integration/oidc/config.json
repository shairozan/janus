{
  "interactiveLogin": true,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "scope",
          "match": "*",
          "claims": {
            "token_use": "access",
            "client_id": "integration-client",
            "cognito:groups": ["customer_admin"]
          }
        }
      ]
    }
  ]
}
