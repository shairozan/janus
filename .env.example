# License Server Configuration
# Copy this file to .env and update values as needed

# Database Configuration
LICENSING_DATABASE_URL=postgres://janus:janus_dev_password@localhost:5432/janus_license?sslmode=disable

# Encryption key for private key storage (must be exactly 32 bytes)
# Generate a new one with: openssl rand -base64 32 | head -c 32
LICENSING_ENCRYPTION_KEY=
# Server Configuration
LICENSING_PORT=8443
LICENSING_HOST=0.0.0.0