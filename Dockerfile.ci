# Dockerfile for Janus CI/CD environment
# Includes all GUI dependencies, Go toolchain, and headless display setup
FROM ubuntu:22.04

LABEL maintainer="shairozan"
LABEL description="Janus CI/CD build environment with GUI dependencies"
LABEL version="1.0"

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install system dependencies for GUI applications and Go development
RUN apt-get update && apt-get install -y \
    # Core build tools
    curl \
    git \
    gcc \
    g++ \
    gcc-multilib \
    g++-multilib \
    libc6-dev \
    make \
    pkg-config \
    ca-certificates \
    # GUI and OpenGL dependencies for Fyne
    libgl1-mesa-dev \
    libgl1-mesa-glx \
    xorg-dev \
    libxrandr2 \
    libxinerama1 \
    libxcursor1 \
    libxi6 \
    libxss1 \
    # Virtual display for headless GUI testing
    xvfb \
    # Additional utilities
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Install Go
ARG GO_VERSION=1.25.1
RUN curl -fsSL https://golang.org/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -xzC /usr/local
ENV PATH=/usr/local/go/bin:$PATH
ENV GOPATH=/go
ENV PATH=$GOPATH/bin:$PATH

# Create workspace directory
WORKDIR /workspace

# Install common Go tools used in CI
RUN go install github.com/magefile/mage@latest && \
    curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s -- -b $(go env GOPATH)/bin v2.1.5

# Set up environment for headless GUI testing
ENV DISPLAY=:99
ENV QT_QPA_PLATFORM=offscreen
ENV FYNE_THEME=light
ENV CGO_ENABLED=1

# Create a startup script for Xvfb
RUN echo '#!/bin/bash\n\
# Start virtual display for GUI tests\n\
Xvfb :99 -screen 0 1024x768x24 -ac +extension GLX +render -noreset &\n\
export DISPLAY=:99\n\
# Wait for display to be ready\n\
sleep 2\n\
# Execute the provided command\n\
exec "$@"' > /usr/local/bin/xvfb-run-janus.sh \
    && chmod +x /usr/local/bin/xvfb-run-janus.sh

# Set the entrypoint to use our display script
ENTRYPOINT ["/usr/local/bin/xvfb-run-janus.sh"]
CMD ["/bin/bash"]

# Health check to ensure the environment is ready
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD go version && gcc --version