# Copy to .env.local and fill in. NEVER commit real secrets (.env* is gitignored).

# Auth.js session encryption secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Cognito app client for the portal (a CONFIDENTIAL client — has a secret).
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=
AUTH_COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_xxxxxxxxx

# The license-server origin the BFF (lib/api.ts) forwards Bearer-authed calls to.
LICENSE_SERVER_URL=http://localhost:8080
