				{
					"name": "Rotate Master Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Auto-save the new key ID",
									"var jsonData = pm.response.json();",
									"if (jsonData.new_key_id) {",
									"    pm.collectionVariables.set('masterKeyId', jsonData.new_key_id);",
									"    console.log('Master Key ID saved: ' + jsonData.new_key_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"expires_in_days\": 365\n}"
						},
						"url": {
							"raw": "{{protocol}}://{{host}}:{{port}}/api/v1/keys/rotate",
							"protocol": "{{protocol}}",
							"host": ["{{host}}"],
